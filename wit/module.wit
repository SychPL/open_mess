// The contract between the open_mess core (host) and a platform module (guest).
// Spec: .specs/2026-10-26-open-mess-design.md, section 8.3.
//
// Guests are WebAssembly components built for wasm32-wasip2. Besides the imports below they get
// only wasi:clocks and wasi:random from the host - no filesystem, no sockets, no environment.
// Calls look synchronous to the guest; the host runs them asynchronously with time, memory and
// size limits. Tool arguments and results cross the boundary as JSON text. The core validates a
// shared tool's arguments and result strictly (spec 8.5). For an extra tool it checks that the
// arguments are an object with only the schema's properties, every required one, and `account`
// and `conversation` as text; the module checks the types and ranges of the rest. Its result must
// be a JSON object of at most 1 MiB (spec 2026-10-28-meetings-transcripts, 5.1).

package open-mess:module@0.1.0;

interface types {
    // A platform account as the module knows it; `id` is stable and unique within the module.
    record account-info {
        id: string,
        display-name: string,
    }

    record tool-decl {
        // `[a-z][a-z0-9_]{0,31}`; agents see it as `<module>_<name>`, `-` in the module name as `_`.
        name: string,
        description: string,
        // JSON Schema of the arguments object: `"type": "object"`, at most 32 `properties` with
        // plain names (never `account`, which the core adds), `required` among them, and no
        // `additionalProperties` other than false.
        input-schema: string,
        // Only read tools are listed for now.
        writes: bool,
    }

    record wam-identity {
        client-id: string,
        scopes: list<string>,
    }

    // Address ranges of the media peers a module's `rtc` connections may reach (CIDR, e.g.
    // "52.112.0.0/14"): no private ranges, a prefix of at least /8 for IPv4 and /16 for IPv6, at
    // most 32 ranges (spec 2026-10-29-live-captions, 5.2).
    record media-access {
        peers: list<string>,
    }

    record manifest {
        // Unique module name; accounts are bound to it (spec 8.3).
        name: string,
        version: string,
        // Platform shown to the user, e.g. "teams".
        platform: string,
        // Exact host names or suffix patterns like "*.sharepoint.com".
        hosts: list<string>,
        sign-in-hosts: list<string>,
        wam: option<wam-identity>,
        extra-tools: list<tool-decl>,
        // Present only for a module that uses `rtc`; part of what the user approves.
        media: option<media-access>,
    }

    // An attachment's bytes, which the module fetches with `http.fetch`; during `get-attachment`
    // fetch takes bodies up to the attachment limit instead of the general one. The core writes
    // the bytes to a file it names; a module never writes files (spec 8.5).
    record attachment {
        file-name: string,
        content-type: string,
        data: list<u8>,
    }

    // Someone in a conversation, as the approval of a write shows them.
    record participant {
        id: string,
        display-name: string,
    }

    // What a write is about, as the user sees it when approving it (spec 8.6). The core binds the
    // approval to a fingerprint of the participants' ids and `target-text`, and describes the
    // target again before it runs the write: a change voids the approval.
    record target {
        conversation-title: string,
        // Empty for a channel: a channel is the target itself, its members are not compared.
        participants: list<participant>,
        // The current text of the message a reply, edit or reaction is about; none without one.
        target-text: option<string>,
    }

    variant module-error {
        // The session is gone; the user must sign in again.
        auth-required(string),
        // The server answered in a shape the module does not understand (spec 9.3).
        incompatible(string),
        // The platform refused or failed; the message is safe to show.
        platform(string),
        invalid-args(string),
        not-supported(string),
        // A write may have reached the platform but its answer did not arrive; the core never
        // runs it again by itself (spec 8.5).
        uncertain(string),
    }
}

interface http {
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    variant http-error {
        // Host or address not allowed (host list, private ranges, redirect target).
        blocked(string),
        timeout,
        too-large,
        // A 429 whose Retry-After was longer than the host's maximum wait: the request was refused.
        throttled(u32),
        network(string),
    }

    // The host follows no redirect by itself; 3xx responses come back to the module (spec 8.3).
    fetch: func(req: request) -> result<response, http-error>;
}

interface websocket {
    use http.{http-error};

    // Connections are held by the core; frames arrive through the `events` export.
    open: func(url: string, headers: list<tuple<string, string>>) -> result<u32, http-error>;
    send: func(conn: u32, text: string) -> result<_, http-error>;
    close: func(conn: u32);
}

// A peer connection with one data channel and nothing else (spec 2026-10-29-live-captions,
// 5.2): no audio or video is ever sent or received. Only for a module whose manifest has `media`.
interface rtc {
    use http.{http-error};

    // Opens a connection whose data channel is named `label`. Returns the connection and the
    // host's offer: standard SDP with one data section and local candidates only, gathered fully.
    open: func(label: string) -> result<tuple<u32, string>, http-error>;
    // The remote answer (standard SDP). It must have the offer's single data section and nothing
    // else; candidates outside the manifest's `media` ranges, private ones and ones the system
    // proxy covers are dropped, and an answer with none left is refused (`blocked`, its reason
    // starting with "proxy:" when the proxy took the last ones).
    accept: func(conn: u32, answer: string) -> result<_, http-error>;
    close: func(conn: u32);
}

interface storage {
    variant storage-error {
        quota-exceeded,
        failed(string),
    }

    // Per-module key-value store with a size quota.
    get: func(key: string) -> option<list<u8>>;
    set: func(key: string, value: list<u8>) -> result<_, storage-error>;
    delete: func(key: string);
}

interface secrets {
    // Secrets of this module's accounts, kept in Windows Credential Manager.
    get: func(account: string, key: string) -> option<string>;
    set: func(account: string, key: string, value: string) -> result<_, string>;
    delete: func(account: string, key: string);
}

interface sign-in {
    variant sign-in-error {
        cancelled,
        timed-out,
        refused(string),
        // Host not approved by the user (spec 8.3).
        blocked(string),
    }

    show-device-code: func(code: string, verification-url: string);
    show-qr: func(data: string);
    // Opens an approved HTTPS sign-in page in the configuration window and returns the URL of
    // the first navigation that starts with `redirect-prefix`.
    open-page: func(url: string, redirect-prefix: string) -> result<string, sign-in-error>;
    // Silent or interactive token from Windows WAM for the manifest's approved identity. `claims`
    // is the JSON of a claims challenge (CAE: a 401 with `WWW-Authenticate: ... claims=`), for a
    // new token that satisfies it (spec 9.1).
    wam-token: func(scopes: list<string>, interactive: bool, claims: option<string>) -> result<string, sign-in-error>;
}

interface host {
    enum session-state {
        online,
        offline,
        auth-required,
    }

    record new-message {
        account: string,
        conversation: string,
        message: string,
        // The sender's stable platform id (a participant's `id`, never a display name); the `from`
        // trigger condition compares it.
        sender: string,
        // True when the message is from the signed-in user; such messages never fire triggers.
        // `own` is a WIT keyword, so the name is escaped with `%`; bindings still call it `own`.
        %own: bool,
        mentions-me: bool,
        direct: bool,
    }

    log: func(level: u8, message: string);
    set-timer: func(id: u32, after-ms: u32);
    session: func(account: string, state: session-state);
    message-arrived: func(msg: new-message);
}

interface module {
    // Aliased: a type and a function can't share the name `manifest` in one interface.
    use types.{manifest as module-manifest, account-info, attachment, module-error, target};

    manifest: func() -> module-manifest;
    sign-in: func() -> result<account-info, module-error>;
    // Restores a session from stored secrets at daemon start.
    restore: func(account: string) -> result<_, module-error>;
    sign-out: func(account: string);
    // Ends now everything of the account's that other people see (live captions: leaves the
    // meetings), before the daemon stops, an update pauses the module's events or a scan stops or
    // replaces the module. The instance may get calls afterwards. Limited to 5 s (spec
    // 2026-10-29-live-captions, 4.3).
    end-sessions: func(account: string);
    // Runs a shared tool (spec 8.5) or one of the manifest's extra tools. The writes `send`,
    // `edit_message` and `react` come only once the agent permissions and, where needed, the
    // user's approval allow them (spec 8.6); any successful result means done.
    call: func(account: string, tool: string, args-json: string) -> result<string, module-error>;
    // The `get_attachment` tool: the attachment's bytes, for the core to save.
    get-attachment: func(account: string, conversation: string, message: string, attachment: string) -> result<attachment, module-error>;
    // What a write (`send`, `edit_message`, `react`) in `conversation` would be about; `message` is
    // the message replied to, edited or reacted to. Reads only: changes nothing on the platform
    // and marks nothing as read.
    describe-target: func(account: string, conversation: string, message: option<string>) -> result<target, module-error>;
}

interface events {
    on-ws-message: func(conn: u32, text: string);
    on-ws-closed: func(conn: u32, reason: string);
    on-timer: func(id: u32);
    // Data channel messages that arrived since the last call, and how many were dropped (limits,
    // a full queue) in that time.
    on-rtc-data: func(conn: u32, messages: list<list<u8>>, dropped: u32);
    // "connected", "failed" or "closed"; after "failed" or "closed" the connection is gone.
    on-rtc-state: func(conn: u32, state: string);
}

world platform-module {
    import http;
    import websocket;
    import rtc;
    import storage;
    import secrets;
    import sign-in;
    import host;
    export module;
    export events;
}
